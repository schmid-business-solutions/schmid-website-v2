---
// ContactForm.astro – schlankes Kontaktformular, Versand über EmailJS
---

<form id="contact-form" class="contact-form" novalidate>
	<div class="row">
		<div class="field">
			<label for="cf-name">Name</label>
			<input id="cf-name" name="name" type="text" autocomplete="name" required />
		</div>
		<div class="field">
			<label for="cf-email">E-Mail</label>
			<input id="cf-email" name="email" type="email" autocomplete="email" required />
		</div>
	</div>
	<div class="field">
		<label for="cf-message">Nachricht</label>
		<textarea id="cf-message" name="message" rows="5" required></textarea>
	</div>
	<div class="actions">
		<p class="consent">
			Ihre Angaben werden nur zur Beantwortung Ihrer Anfrage verwendet. <a href="/datenschutz/">Datenschutz</a>
		</p>
		<button id="submit-btn" type="submit"><span class="btn-label">Nachricht senden</span><span class="btn-arrow" aria-hidden="true">→</span></button>
	</div>
	<div id="form-status" class="status" role="status" aria-live="polite" hidden></div>
</form>

<style>
	.contact-form {
		display: grid;
		gap: 36px;
	}

	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 36px 40px;
	}

	.field {
		display: grid;
		gap: 4px;
	}

	label {
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.5);
	}

	input,
	textarea {
		width: 100%;
		font-family: var(--serif);
		font-size: 22px;
		font-weight: 400;
		color: #fff;
		background: transparent;
		border: 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 0;
		padding: 10px 0 12px;
		transition: border-color 0.4s var(--ease);
	}

	textarea {
		resize: vertical;
		min-height: 120px;
		line-height: 1.4;
	}

	input:hover,
	textarea:hover {
		border-bottom-color: rgba(255, 255, 255, 0.4);
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-bottom-color: var(--gold-light);
	}

	.actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		margin-top: 8px;
	}

	.consent {
		margin: 0;
		max-width: 24em;
		font-size: 13px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.42);
	}

	.consent a {
		color: rgba(255, 255, 255, 0.7);
		text-underline-offset: 3px;
	}

	button {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 18px;
		font-family: var(--sans);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--gold-light);
		background: transparent;
		border: 1px solid rgba(201, 172, 116, 0.55);
		border-radius: 0;
		padding: 20px 30px 20px 34px;
		cursor: pointer;
		transition: background 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s var(--ease);
	}

	.btn-arrow {
		font-size: 15px;
		letter-spacing: 0;
		transition: transform 0.4s var(--ease);
	}

	button:hover {
		background: var(--gold-light);
		border-color: var(--gold-light);
		color: var(--dark);
	}

	button:hover .btn-arrow {
		transform: translateX(4px);
	}

	button:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.status {
		font-size: 15px;
		line-height: 1.6;
		padding: 16px 0 0;
		border-top: 1px solid var(--dark-line);
	}

	.status[data-kind='success'] {
		color: var(--gold-light);
	}

	.status[data-kind='error'] {
		color: #e8b4ab;
	}

	@media (max-width: 600px) {
		.row {
			grid-template-columns: 1fr;
		}

		.actions {
			flex-direction: column-reverse;
			align-items: stretch;
		}

		button {
			justify-content: space-between;
		}
	}
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4.4.1/dist/email.min.js"></script>
<script is:inline>
	(function () {
		var form = document.getElementById('contact-form');
		var btn = document.getElementById('submit-btn');
		var statusBox = document.getElementById('form-status');
		var label = btn.querySelector('.btn-label');
		if (!form) return;

		if (window.emailjs) {
			emailjs.init({ publicKey: 'FQeBWdwkjiwk9aYxl' });
		}

		function showStatus(kind, text) {
			statusBox.textContent = text;
			statusBox.dataset.kind = kind;
			statusBox.hidden = false;
		}

		form.addEventListener('submit', function (e) {
			e.preventDefault();
			statusBox.hidden = true;

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			if (!window.emailjs) {
				showStatus('error', 'Das Formular ist gerade nicht verfügbar. Bitte schreiben Sie direkt an office@ivanschmid.com.');
				return;
			}

			btn.disabled = true;
			label.textContent = 'Wird gesendet …';

			var params = {
				to_email: 'schmidmobile@gmail.com',
				from_name: form.name.value.trim(),
				from_email: form.email.value.trim(),
				request: 'Kontaktformular ivanschmid.com',
				message: form.message.value.trim(),
				subject: 'Website Anfrage von ivanschmid.com'
			};

			emailjs
				.send('service_mtfmush', 'template_ws51hqc', params)
				.then(function () {
					showStatus('success', 'Vielen Dank für Ihre Nachricht. Ich melde mich zeitnah persönlich bei Ihnen.');
					form.reset();
				})
				.catch(function (err) {
					console.error('EmailJS:', err);
					showStatus('error', 'Beim Senden ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut oder schreiben Sie direkt an office@ivanschmid.com.');
				})
				.finally(function () {
					btn.disabled = false;
					label.textContent = 'Nachricht senden';
				});
		});
	})();
</script>
