---
// ContactForm.astro – schlankes Kontaktformular, Versand über EmailJS
---

<form id="contact-form" class="contact-form" novalidate>
	<div class="row">
		<div class="field">
			<label for="cf-name">Name</label>
			<input id="cf-name" name="name" type="text" autocomplete="name" required />
		</div>
		<div class="field">
			<label for="cf-email">E-Mail</label>
			<input id="cf-email" name="email" type="email" autocomplete="email" required />
		</div>
	</div>
	<div class="field">
		<label for="cf-message">Nachricht</label>
		<textarea id="cf-message" name="message" rows="5" required></textarea>
	</div>
	<div class="actions">
		<p class="consent">
			Ihre Angaben werden nur zur Beantwortung Ihrer Anfrage verwendet. <a href="/datenschutz/">Datenschutz</a>
		</p>
		<button id="submit-btn" type="submit"><span class="btn-label">Nachricht senden</span><span class="btn-arrow" aria-hidden="true">→</span></button>
	</div>
	<div id="form-status" class="status" role="status" aria-live="polite" hidden></div>
</form>

<style>
	.contact-form {
		display: grid;
		gap: 20px;
	}

	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.field {
		display: grid;
		gap: 8px;
	}

	label {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: rgba(255, 255, 255, 0.6);
	}

	input,
	textarea {
		width: 100%;
		font: inherit;
		font-size: 16px;
		color: #fff;
		background: var(--dark-2);
		border: 1px solid var(--dark-line);
		border-radius: 14px;
		padding: 15px 16px;
		transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
	}

	textarea {
		resize: vertical;
		min-height: 150px;
	}

	input:hover,
	textarea:hover {
		border-color: rgba(255, 255, 255, 0.28);
	}

	input:focus,
	textarea:focus {
		outline: none;
		background: #26282d;
		border-color: var(--gold);
		box-shadow: 0 0 0 4px rgba(201, 169, 77, 0.18);
	}

	.actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-top: 4px;
	}

	.consent {
		margin: 0;
		max-width: 26em;
		font-size: 13px;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.5);
	}

	.consent a {
		color: rgba(255, 255, 255, 0.8);
	}

	button {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font: inherit;
		font-size: 16px;
		font-weight: 700;
		color: var(--dark);
		background: var(--gold);
		border: 0;
		border-radius: 999px;
		padding: 15px 18px 15px 28px;
		cursor: pointer;
		transition: background 0.2s, transform 0.2s;
	}

	.btn-arrow {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--dark);
		color: var(--gold);
		transition: transform 0.2s;
	}

	button:hover {
		background: #d8ba60;
	}

	button:hover .btn-arrow {
		transform: translateX(3px);
	}

	button:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.status {
		font-size: 15px;
		line-height: 1.5;
		border-radius: 14px;
		padding: 14px 16px;
	}

	.status[data-kind='success'] {
		background: rgba(130, 190, 120, 0.12);
		color: #c8e6bf;
		border: 1px solid rgba(130, 190, 120, 0.3);
	}

	.status[data-kind='error'] {
		background: rgba(230, 110, 95, 0.12);
		color: #f3c3bc;
		border: 1px solid rgba(230, 110, 95, 0.3);
	}

	@media (max-width: 600px) {
		.row {
			grid-template-columns: 1fr;
		}

		.actions {
			flex-direction: column-reverse;
			align-items: stretch;
		}

		button {
			justify-content: space-between;
		}
	}
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4.4.1/dist/email.min.js"></script>
<script is:inline>
	(function () {
		var form = document.getElementById('contact-form');
		var btn = document.getElementById('submit-btn');
		var statusBox = document.getElementById('form-status');
		var label = btn.querySelector('.btn-label');
		if (!form) return;

		if (window.emailjs) {
			emailjs.init({ publicKey: 'FQeBWdwkjiwk9aYxl' });
		}

		function showStatus(kind, text) {
			statusBox.textContent = text;
			statusBox.dataset.kind = kind;
			statusBox.hidden = false;
		}

		form.addEventListener('submit', function (e) {
			e.preventDefault();
			statusBox.hidden = true;

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			if (!window.emailjs) {
				showStatus('error', 'Das Formular ist gerade nicht verfügbar. Bitte schreiben Sie direkt an office@ivanschmid.com.');
				return;
			}

			btn.disabled = true;
			label.textContent = 'Wird gesendet …';

			var params = {
				to_email: 'schmidmobile@gmail.com',
				from_name: form.name.value.trim(),
				from_email: form.email.value.trim(),
				request: 'Kontaktformular ivanschmid.com',
				message: form.message.value.trim(),
				subject: 'Website Anfrage von ivanschmid.com'
			};

			emailjs
				.send('service_mtfmush', 'template_ws51hqc', params)
				.then(function () {
					showStatus('success', 'Vielen Dank für Ihre Nachricht. Ich melde mich zeitnah persönlich bei Ihnen.');
					form.reset();
				})
				.catch(function (err) {
					console.error('EmailJS:', err);
					showStatus('error', 'Beim Senden ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut oder schreiben Sie direkt an office@ivanschmid.com.');
				})
				.finally(function () {
					btn.disabled = false;
					label.textContent = 'Nachricht senden';
				});
		});
	})();
</script>
