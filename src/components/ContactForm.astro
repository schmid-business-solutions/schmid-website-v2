---
// ContactForm.astro – schlankes Kontaktformular, Versand über EmailJS
---

<form id="contact-form" class="contact-form" novalidate>
	<div class="field">
		<label for="cf-name">Name</label>
		<input id="cf-name" name="name" type="text" autocomplete="name" required />
	</div>
	<div class="field">
		<label for="cf-email">E-Mail</label>
		<input id="cf-email" name="email" type="email" autocomplete="email" required />
	</div>
	<div class="field">
		<label for="cf-message">Nachricht</label>
		<textarea id="cf-message" name="message" rows="5" required></textarea>
	</div>
	<p class="consent">
		Ihre Angaben werden nur zur Beantwortung Ihrer Anfrage verwendet. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.
	</p>
	<div id="form-status" class="status" role="status" aria-live="polite" hidden></div>
	<button id="submit-btn" type="submit">Nachricht senden</button>
</form>

<style>
	.contact-form {
		display: grid;
		gap: 18px;
	}

	.field {
		display: grid;
		gap: 6px;
	}

	label {
		font-size: 14px;
		font-weight: 600;
		color: var(--ink);
	}

	input,
	textarea {
		width: 100%;
		font: inherit;
		font-size: 16px;
		color: var(--ink);
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 12px 14px;
		transition: border-color 0.15s, box-shadow 0.15s;
	}

	textarea {
		resize: vertical;
		min-height: 130px;
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--gold);
		box-shadow: 0 0 0 3px rgba(179, 155, 60, 0.18);
	}

	.consent {
		margin: 0;
		font-size: 13px;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	button {
		justify-self: start;
		font: inherit;
		font-size: 15px;
		font-weight: 700;
		color: #fff;
		background: var(--ink);
		border: 0;
		border-radius: 999px;
		padding: 13px 28px;
		cursor: pointer;
		transition: background 0.15s;
	}

	button:hover {
		background: var(--gold-dark);
	}

	button:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.status {
		font-size: 15px;
		line-height: 1.5;
		border-radius: 10px;
		padding: 12px 14px;
	}

	.status[data-kind='success'] {
		background: #f3f7ef;
		color: #335a26;
		border: 1px solid #d5e4c9;
	}

	.status[data-kind='error'] {
		background: #fcf1f0;
		color: #8a2a1f;
		border: 1px solid #f0d3cf;
	}

	@media (max-width: 520px) {
		button {
			justify-self: stretch;
		}
	}
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4.4.1/dist/email.min.js"></script>
<script is:inline>
	(function () {
		var form = document.getElementById('contact-form');
		var btn = document.getElementById('submit-btn');
		var statusBox = document.getElementById('form-status');
		if (!form) return;

		if (window.emailjs) {
			emailjs.init({ publicKey: 'FQeBWdwkjiwk9aYxl' });
		}

		function showStatus(kind, text) {
			statusBox.textContent = text;
			statusBox.dataset.kind = kind;
			statusBox.hidden = false;
		}

		form.addEventListener('submit', function (e) {
			e.preventDefault();
			statusBox.hidden = true;

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			if (!window.emailjs) {
				showStatus('error', 'Das Formular ist gerade nicht verfügbar. Bitte schreiben Sie direkt an office@ivanschmid.com.');
				return;
			}

			btn.disabled = true;
			btn.textContent = 'Wird gesendet …';

			var params = {
				to_email: 'schmidmobile@gmail.com',
				from_name: form.name.value.trim(),
				from_email: form.email.value.trim(),
				request: 'Kontaktformular ivanschmid.com',
				message: form.message.value.trim(),
				subject: 'Website Anfrage von ivanschmid.com'
			};

			emailjs
				.send('service_mtfmush', 'template_ws51hqc', params)
				.then(function () {
					showStatus('success', 'Vielen Dank für Ihre Nachricht. Ich melde mich zeitnah persönlich bei Ihnen.');
					form.reset();
				})
				.catch(function (err) {
					console.error('EmailJS:', err);
					showStatus('error', 'Beim Senden ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut oder schreiben Sie direkt an office@ivanschmid.com.');
				})
				.finally(function () {
					btn.disabled = false;
					btn.textContent = 'Nachricht senden';
				});
		});
	})();
</script>
