---
interface Props {
	inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['logo', { inverse }]}>
	<span class="logo-name">Schmid</span>
	<span class="logo-rule" aria-hidden="true"></span>
	<span class="logo-sub">Business Solutions</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		line-height: 1;
		white-space: nowrap;
	}

	.logo-name {
		font-weight: 800;
		font-size: 21px;
		letter-spacing: -0.03em;
	}

	.logo-rule {
		width: 2px;
		height: 20px;
		border-radius: 2px;
		background: var(--gold);
	}

	.logo-sub {
		font-weight: 500;
		font-size: 16px;
		letter-spacing: -0.01em;
		color: var(--muted);
	}

	.inverse {
		color: #fff;
	}

	.inverse .logo-sub {
		color: rgba(255, 255, 255, 0.6);
	}

	@media (max-width: 380px) {
		.logo {
			gap: 9px;
		}
		.logo-name {
			font-size: 19px;
		}
		.logo-sub {
			font-size: 14px;
		}
	}
</style>
