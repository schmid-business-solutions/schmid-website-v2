---
interface Props {
	inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['logo', { inverse }]}>
	<span class="logo-name">Schmid</span>
	<span class="logo-sub">Business Solutions</span>
</span>

<style>
	.logo {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 5px;
		color: var(--ink);
		line-height: 1;
		white-space: nowrap;
	}

	.logo-name {
		font-family: var(--serif);
		font-weight: 500;
		font-size: 27px;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		margin-right: -0.34em;
	}

	.logo-sub {
		font-family: var(--sans);
		font-weight: 500;
		font-size: 9.5px;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		margin-right: -0.3em;
		color: var(--gold);
	}

	.inverse {
		color: #fff;
	}

	.inverse .logo-sub {
		color: var(--gold-light);
	}

	@media (max-width: 560px) {
		.logo-name {
			font-size: 21px;
		}
		.logo-sub {
			font-size: 8.5px;
			letter-spacing: 0.22em;
			margin-right: -0.22em;
		}
	}
</style>
