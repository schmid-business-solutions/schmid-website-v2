---
interface Props {
	inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['logo', { inverse }]}>
	<span class="logo-text">
		<span class="logo-name">Schmid</span>
		<span class="logo-sub">Business Solutions</span>
	</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		white-space: nowrap;
	}




	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}

	.logo-name {
		font-weight: 800;
		font-size: 19px;
		letter-spacing: -0.02em;
	}

	.logo-sub {
		font-weight: 500;
		font-size: 14px;
		color: var(--muted);
	}

	.inverse {
		color: #fff;
	}



	.inverse .logo-sub {
		color: rgba(255, 255, 255, 0.6);
	}
</style>
