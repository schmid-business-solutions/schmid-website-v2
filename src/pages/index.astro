---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout title="Ivan Schmid – Unternehmer">
	<main>
		<section class="wrap intro">
			<img
				class="portrait"
				src="/portrait.webp"
				width="1000"
				height="1250"
				alt="Portrait von Ivan Schmid"
				fetchpriority="high"
			/>
			<div class="intro-text">
				<h1>Ivan Schmid</h1>
				<p>
					Ich bin Unternehmer aus Überzeugung. Seit über 25 Jahren baue ich Unternehmen, Produkte und
					digitale Plattformen auf – unter anderem als Gründer von Payrexx, Hotelcard und Comvation.
					Heute bin ich Geschäftsführer der Payrexx Europe AG.
				</p>
			</div>
		</section>

		<section class="wrap contact" aria-labelledby="kontakt-titel">
			<h2 id="kontakt-titel">Kontakt</h2>
			<ContactForm />
		</section>
	</main>
</Layout>

<style>
	.intro {
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 36px;
		align-items: center;
		padding-top: 64px;
		padding-bottom: 64px;
	}

	.portrait {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius);
		background: var(--paper-2);
	}

	h1 {
		margin: 0 0 12px;
		font-size: 30px;
		line-height: 1.2;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.intro-text p {
		margin: 0;
		color: var(--ink-soft);
	}

	.contact {
		padding-bottom: 48px;
	}

	h2 {
		margin: 0 0 24px;
		padding-top: 40px;
		border-top: 1px solid var(--line);
		font-size: 20px;
		font-weight: 700;
	}

	@media (max-width: 560px) {
		.intro {
			grid-template-columns: 1fr;
			gap: 24px;
			padding-top: 40px;
			padding-bottom: 48px;
		}

		.portrait {
			width: 160px;
		}

		h1 {
			font-size: 26px;
		}
	}
</style>
