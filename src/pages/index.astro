---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout title="Ivan Schmid – Unternehmer">
	<main>
		<section class="hero container">
			<p class="caps eyebrow reveal">Unternehmer · Steffisburg</p>
			<h1 class="reveal reveal-2">Ivan Schmid</h1>
			<span class="rule reveal reveal-3" aria-hidden="true"></span>
		</section>

		<figure class="hero-image reveal-img">
			<img
				src="/heronew.webp"
				width="2560"
				height="1100"
				alt="Ivan Schmid an seinem Arbeitsplatz mit Blick auf den Thunersee"
				fetchpriority="high"
			/>
		</figure>

		<section class="intro container">
			<p class="lead">
				Ich bin Unternehmer aus Überzeugung. Seit über 25 Jahren baue ich Unternehmen, Produkte und digitale
				Plattformen auf – unter anderem als Gründer von Payrexx, Hotelcard, Comvation und 1Daily.
			</p>
			<a class="partner" href="https://www.payrexx.com/?ref=s32026" target="_blank" rel="noopener">
				<span class="partner-rule" aria-hidden="true"></span>
				<span class="caps">Offizieller Payrexx Solution Partner</span>
				<span class="partner-arrow" aria-hidden="true">↗</span>
			</a>
		</section>

		<section class="contact" id="kontakt" aria-labelledby="kontakt-titel">
			<div class="container contact-inner">
				<div class="contact-head">
					<p class="caps contact-eyebrow">Kontakt</p>
					<h2 id="kontakt-titel">Ich freue mich<br /><em>auf Ihre Nachricht.</em></h2>
				</div>
				<ContactForm />
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		text-align: center;
		padding-top: clamp(64px, 10vw, 136px);
		padding-bottom: clamp(48px, 7vw, 96px);
	}

	.eyebrow {
		margin: 0 0 clamp(20px, 3vw, 32px);
		color: var(--gold);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(60px, 11vw, 168px);
		line-height: 0.95;
		letter-spacing: -0.015em;
	}

	.rule {
		display: block;
		width: 1px;
		height: clamp(40px, 6vw, 72px);
		margin: clamp(32px, 4vw, 48px) auto 0;
		background: var(--gold);
	}

	.hero-image {
		margin: 0;
		overflow: hidden;
		aspect-ratio: 2560 / 1040;
		max-height: 82vh;
		width: 100%;
		background: var(--paper-2);
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 32% 25%;
		scale: 1.035;
		transform-origin: 0 0;
	}

	.intro {
		max-width: 920px;
		text-align: center;
		padding-top: clamp(72px, 10vw, 144px);
		padding-bottom: clamp(80px, 11vw, 160px);
	}

	.lead {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(26px, 3.1vw, 40px);
		line-height: 1.35;
		color: var(--ink);
		text-wrap: balance;
		font-variant-numeric: lining-nums;
	}

	.partner {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		margin-top: clamp(40px, 5vw, 64px);
		text-decoration: none;
		color: var(--ink-2);
		transition: color 0.4s var(--ease);
	}

	.partner-rule {
		width: 40px;
		height: 1px;
		background: var(--gold);
		transition: width 0.5s var(--ease);
	}

	.partner-arrow {
		color: var(--gold);
		font-size: 14px;
		transition: transform 0.4s var(--ease);
	}

	.partner:hover {
		color: var(--ink);
	}

	.partner:hover .partner-rule {
		width: 64px;
	}

	.partner:hover .partner-arrow {
		transform: translate(2px, -2px);
	}

	.contact {
		background: var(--dark);
		color: #fff;
	}

	.contact-inner {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: clamp(48px, 8vw, 128px);
		padding-top: clamp(88px, 11vw, 160px);
		padding-bottom: clamp(88px, 11vw, 160px);
	}

	.contact-eyebrow {
		margin: 0 0 28px;
		color: var(--gold-light);
	}

	h2 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(42px, 4.6vw, 68px);
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	h2 em {
		font-style: italic;
		color: var(--gold-light);
	}

	@media (max-width: 860px) {
		.contact-inner {
			grid-template-columns: 1fr;
		}

		.hero-image {
			aspect-ratio: 16 / 9;
		}
	}

	@media (max-width: 520px) {

		.lead {
			text-wrap: pretty;
		}

		.partner {
			flex-direction: column;
			gap: 14px;
		}

		.partner .caps {
			letter-spacing: 0.22em;
		}

		.partner-arrow {
			display: none;
		}
	}
</style>
