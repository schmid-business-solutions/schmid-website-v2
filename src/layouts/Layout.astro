---
import '@fontsource-variable/manrope';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}

const {
	title,
	description = 'Ivan Schmid – Unternehmer aus Steffisburg. Seit über 25 Jahren baue ich Unternehmen, Produkte und digitale Plattformen auf.',
	noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="de-CH">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Ivan Schmid" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_CH" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/portrait.webp', Astro.site).href} />
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="logo" aria-label="Schmid Business Solutions – Startseite">
				<span class="logo-mark">SCHMID<sup>3</sup></span>
				<span class="logo-sub">Business Solutions</span>
			</a>
		</header>

		<slot />

		<footer class="site-footer">
			<span>© {new Date().getFullYear()} Schmid Business Solutions</span>
			<nav aria-label="Rechtliches">
				<a href="/impressum/">Impressum</a>
				<a href="/datenschutz/">Datenschutz</a>
			</nav>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--ink: #2b2d30;
		--ink-soft: #5c5f64;
		--line: #e3e1dc;
		--paper: #ffffff;
		--paper-2: #f7f6f3;
		--gold: #b39b3c;
		--gold-dark: #8f7b2b;
		--radius: 14px;
		color-scheme: light;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: 'Manrope Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: 17px;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
	}

	a {
		color: var(--gold-dark);
	}

	.wrap {
		width: 100%;
		max-width: 640px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.site-header {
		width: 100%;
		max-width: 640px;
		margin: 0 auto;
		padding: 40px 24px 0;
	}

	.logo {
		display: inline-flex;
		flex-direction: column;
		line-height: 1;
		text-decoration: none;
	}

	.logo-mark {
		color: var(--gold);
		font-weight: 800;
		font-size: 22px;
		letter-spacing: 0.16em;
	}

	.logo-mark sup {
		font-size: 0.6em;
		font-weight: 800;
		letter-spacing: 0;
		margin-left: 1px;
	}

	.logo-sub {
		color: var(--ink-soft);
		font-size: 13px;
		font-weight: 400;
		letter-spacing: 0.04em;
		margin-top: 6px;
	}

	.site-footer {
		width: 100%;
		max-width: 640px;
		margin: 0 auto;
		padding: 32px 24px 40px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		justify-content: space-between;
		color: var(--ink-soft);
		font-size: 13px;
	}

	.site-footer nav {
		display: flex;
		gap: 20px;
	}

	.site-footer a {
		color: var(--ink-soft);
		text-decoration: none;
	}

	.site-footer a:hover {
		color: var(--gold-dark);
	}
</style>
