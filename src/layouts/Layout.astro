---
import '@fontsource-variable/manrope';
import Logo from '../components/Logo.astro';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}

const {
	title,
	description = 'Ivan Schmid – Unternehmer aus Steffisburg. Seit über 25 Jahren baue ich Unternehmen, Produkte und digitale Plattformen auf.',
	noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="de-CH">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Ivan Schmid" />
		<meta name="theme-color" content="#ffffff" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_CH" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/heronew.webp', Astro.site).href} />
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" aria-label="Ivan Schmid – Startseite"><Logo /></a>
				<a class="header-cta" href="/#kontakt">Kontakt</a>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="container"><div class="footer-inner">
				<span>© {new Date().getFullYear()} Schmid Business Solutions, Steffisburg</span>
				<nav aria-label="Rechtliches">
					<a href="/impressum/">Impressum</a>
					<a href="/datenschutz/">Datenschutz</a>
				</nav>
			</div></div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--ink: #16171a;
		--ink-2: #3d4046;
		--muted: #6b6f76;
		--line: #e7e5e0;
		--paper: #ffffff;
		--paper-2: #f5f4f1;
		--gold: #c9a94d;
		--gold-dark: #9a7f2e;
		--dark: #16171a;
		--dark-2: #222328;
		--dark-line: rgba(255, 255, 255, 0.14);
		--container: 1200px;
		--gutter: clamp(20px, 4vw, 48px);
		color-scheme: light;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: 'Manrope Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: 17px;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	a {
		color: inherit;
	}

	.container {
		width: 100%;
		max-width: var(--container);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: saturate(160%) blur(14px);
		-webkit-backdrop-filter: saturate(160%) blur(14px);
		border-bottom: 1px solid transparent;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 76px;
	}

	.site-header a {
		text-decoration: none;
	}

	.header-cta {
		font-size: 15px;
		font-weight: 600;
		padding: 10px 20px;
		border-radius: 999px;
		border: 1px solid var(--line);
		transition: background 0.2s, border-color 0.2s;
	}

	.header-cta:hover {
		background: var(--paper-2);
		border-color: var(--paper-2);
	}

	@media (max-width: 420px) {
		.header-cta {
			padding: 8px 14px;
			font-size: 14px;
		}
	}

	.site-footer {
		background: var(--dark);
		color: rgba(255, 255, 255, 0.55);
		font-size: 14px;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
		justify-content: space-between;
		padding-top: 28px;
		padding-bottom: 32px;
		border-top: 1px solid var(--dark-line);
	}

	.site-footer nav {
		display: flex;
		gap: 24px;
	}

	.site-footer a {
		text-decoration: none;
		transition: color 0.2s;
	}

	.site-footer a:hover {
		color: #fff;
	}

	@media (prefers-reduced-motion: no-preference) {
		.reveal {
			animation: reveal 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}
		.reveal-2 {
			animation-delay: 0.12s;
		}
		.reveal-3 {
			animation-delay: 0.24s;
		}
		@keyframes reveal {
			from {
				opacity: 0;
				transform: translateY(18px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
	}
</style>
