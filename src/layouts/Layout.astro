---
import '@fontsource-variable/manrope';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import Logo from '../components/Logo.astro';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}

const {
	title,
	description = 'Ivan Schmid – Unternehmer aus Steffisburg. Seit über 25 Jahren baue ich Unternehmen, Produkte und digitale Plattformen auf.',
	noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="de-CH">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Ivan Schmid" />
		<meta name="theme-color" content="#faf8f4" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_CH" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/heronew.webp', Astro.site).href} />
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<div class="header-inner">
					<a href="/" aria-label="Schmid Business Solutions – Startseite"><Logo /></a>
					<a class="header-link" href="/#kontakt">Kontakt</a>
				</div>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="container">
				<div class="footer-inner">
					<span>© {new Date().getFullYear()} Schmid Business Solutions · Steffisburg</span>
					<nav aria-label="Rechtliches">
						<a href="/impressum/">Impressum</a>
						<a href="/datenschutz/">Datenschutz</a>
					</nav>
				</div>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var header = document.querySelector('.site-header');
				function onScroll() {
					if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
				}
				onScroll();
				window.addEventListener('scroll', onScroll, { passive: true });

				var items = document.querySelectorAll('.in-view');
				var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!('IntersectionObserver' in window) || reduce) return;
				document.documentElement.classList.add('js-reveal');
				var io = new IntersectionObserver(
					function (entries) {
						entries.forEach(function (e) {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								io.unobserve(e.target);
							}
						});
					},
					{ rootMargin: '0px 0px -12% 0px' }
				);
				items.forEach(function (el) {
					io.observe(el);
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--ink: #1b1a18;
		--ink-2: #3f3c37;
		--muted: #7c776e;
		--line: #e4dfd4;
		--paper: #faf8f4;
		--paper-2: #f2eee6;
		--gold: #a8874a;
		--gold-light: #c9ac74;
		--dark: #141311;
		--dark-2: #1d1c19;
		--dark-line: rgba(255, 255, 255, 0.12);
		--serif: 'Cormorant Garamond', 'Times New Roman', serif;
		--sans: 'Manrope Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
		--container: 1240px;
		--gutter: clamp(20px, 5vw, 64px);
		--ease: cubic-bezier(0.22, 0.61, 0.36, 1);
		color-scheme: light;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--sans);
		font-size: 16px;
		font-weight: 400;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	a {
		color: inherit;
	}

	::selection {
		background: rgba(168, 135, 74, 0.25);
	}

	.container {
		width: 100%;
		max-width: var(--container);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.caps {
		font-family: var(--sans);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(250, 248, 244, 0);
		transition: background 0.5s var(--ease), backdrop-filter 0.5s var(--ease);
	}

	.site-header.is-scrolled {
		background: rgba(250, 248, 244, 0.86);
		backdrop-filter: blur(18px) saturate(140%);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 88px;
		border-bottom: 1px solid transparent;
		transition: height 0.5s var(--ease), border-color 0.5s var(--ease);
	}

	.is-scrolled .header-inner {
		height: 72px;
		border-bottom-color: var(--line);
	}

	.js-reveal .in-view {
		opacity: 0;
		transform: translateY(28px);
		transition: opacity 1.2s var(--ease), transform 1.2s var(--ease);
	}

	.js-reveal .in-view.is-visible {
		opacity: 1;
		transform: none;
	}

	.js-reveal .in-view + .in-view {
		transition-delay: 0.12s;
	}

	.site-header a {
		text-decoration: none;
	}

	.header-link {
		position: relative;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		padding: 6px 0;
	}

	.header-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0.32em;
		bottom: 0;
		height: 1px;
		background: var(--gold);
		transform: scaleX(0.35);
		transform-origin: left;
		transition: transform 0.5s var(--ease);
	}

	.header-link:hover::after {
		transform: scaleX(1);
	}

	.site-footer {
		background: var(--dark);
		color: rgba(255, 255, 255, 0.45);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 14px 32px;
		justify-content: space-between;
		padding-top: 32px;
		padding-bottom: 36px;
		border-top: 1px solid var(--dark-line);
	}

	.site-footer nav {
		display: flex;
		gap: 28px;
	}

	.site-footer a {
		text-decoration: none;
		transition: color 0.3s;
	}

	.site-footer a:hover {
		color: var(--gold-light);
	}

	@media (prefers-reduced-motion: no-preference) {
		.reveal {
			animation: reveal 1.4s var(--ease) both;
		}
		.reveal-2 {
			animation-delay: 0.15s;
		}
		.reveal-3 {
			animation-delay: 0.3s;
		}
		.reveal-img img {
			animation: settle 2.4s var(--ease) both;
		}
		@keyframes reveal {
			from {
				opacity: 0;
				transform: translateY(14px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
		@keyframes settle {
			from {
				opacity: 0;
				transform: scale(1.04);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
	}

	@media (max-width: 560px) {
		.header-inner {
			height: 72px;
		}
	}
</style>
